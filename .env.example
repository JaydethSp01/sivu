# =====================================================================
# SIVU — variables de entorno (copia a .env y ajusta lo necesario)
# =====================================================================

# --- Postgres (Core DB) ---
POSTGRES_DB=sivu
POSTGRES_USER=sivu
POSTGRES_PASSWORD=sivu_dev_password
POSTGRES_PORT=5432

# --- MongoDB (Users DB) ---
MONGO_INITDB_ROOT_USERNAME=sivu_admin
MONGO_INITDB_ROOT_PASSWORD=mongo_dev_password
MONGO_INITDB_DATABASE=sivu_users
MONGO_PORT=27017

# --- Backend Spring Boot ---
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=dev
JWT_SECRET=changeme_super_long_random_secret_at_least_64_chars_for_hs512_alg_xxxxxxxx
JWT_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_DAYS=7

# --- Datasources (interpretados por Spring) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/sivu
SPRING_DATASOURCE_USERNAME=sivu
SPRING_DATASOURCE_PASSWORD=sivu_dev_password
SPRING_DATA_MONGODB_URI=mongodb://sivu_admin:mongo_dev_password@mongo:27017/sivu_users?authSource=admin

# --- Mail (MailHog en local) ---
SPRING_MAIL_HOST=mailhog
SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
APP_MAIL_FROM=no-reply@sivu.uempresarial.edu.co
MAILHOG_UI_PORT=8025

# --- Frontend ---
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8080/api/v1

# --- MCP Server ---
MCP_BACKEND_BASE_URL=http://backend:8080/api/v1
MCP_SERVICE_USER=mcp_agent@sivu.uempresarial.edu.co
MCP_SERVICE_PASSWORD=Mcp_Agent123*

# --- App ---
APP_TIMEZONE=America/Bogota
APP_LOCALE=es-CO
APP_UNIVERSIDAD_API_BASE=http://backend:8080/api/v1/mock-universidad
