# =========================================================================
# Configuración del SIVU MCP Server
# Copia este archivo a `.env` y ajusta los valores para tu entorno local.
# =========================================================================

# URL base del backend Spring Boot (incluye el prefijo /api/v1)
MCP_BACKEND_BASE_URL=http://localhost:8080/api/v1

# Credenciales del usuario semilla con rol MCP_AGENT (ver V1__seed_data o flyway)
MCP_SERVICE_USER=mcp_agent@sivu.uempresarial.edu.co
MCP_SERVICE_PASSWORD=Mcp_Agent123*

# Timeout (ms) para llamadas HTTP al backend
MCP_HTTP_TIMEOUT_MS=15000

# --- Opcional: integración con GitHub Actions para `revisar_logs_pipeline` ---
# Token con scope `actions:read` (o `repo` para repos privados)
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Formato: "owner/repo"
# GITHUB_REPO=mi-org/sivu

# --- Logging ---
# debug | info | warn | error
MCP_LOG_LEVEL=info
